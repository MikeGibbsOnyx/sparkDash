#!/bin/sh
# sparkdash-set-clock — privileged clock-cap helper for sparkDash.
#
# Runs ON THE DGX SPARK HOST as root (installed by install-clock-helper.sh,
# invoked by the dashboard over SSH as the operator's SSH user, through a
# passwordless sudo rule pinned to this binary's exact argv). Applies a CPU or
# GPU clock cap live and, optionally, persists it to the boot systemd unit.
#
# Usage:
#   sparkdash-set-clock --domain cpu-big|cpu-little|gpu
#                       (--max-mhz <int> | --unlock)
#                       (--persist | --no-persist)
#
# Order of work: APPLY FIRST. Persistence is attempted only after the live
# apply succeeded, so a failed apply never leaves a boot unit behind that
# would install an untested value on the next boot.
#
# Output contract (parsed by the dashboard; one item per line):
#   core=cpuN knob=<max_perf|scaling_max_freq> khz=<read-back>   (CPU only)
#   persisted=<0|1>
#   All done.                                                     (always last)
# A persist that fails after a good apply prints persisted=0 plus a
# `persist_error:` line on stderr and still exits 0 (the live cap holds).
#
# Exit codes:
#   0 ok · 1 usage/invalid · 2 no cores for domain · 3 unsupported domain · 4 apply failed
#
# Availability probing: `sparkdash-set-clock --check` prints
# "sparkdash-set-clock: ok", exits 0 and changes nothing. It is a pinned entry
# in the sudoers grant like every other form (same contract as the
# spark-shutdown helper's --check). An argumentless run prints usage, exits 1.
set -eu

CPU_SYS=${SPARKDASH_CPU_SYS:-/sys/devices/system/cpu}
UNIT_DIR=${SPARKDASH_UNIT_DIR:-/etc/systemd/system}
CPU_UNIT=$UNIT_DIR/cpu-clock-cap.service
GPU_UNIT=$UNIT_DIR/gpu-clock-lock.service
SMI=${SPARKDASH_SMI:-/usr/bin/nvidia-smi}

# Test hooks only: SPARKDASH_CPU_SYS / SPARKDASH_UNIT_DIR / SPARKDASH_SMI
# redirect the sysfs, unit, and nvidia-smi paths. Under the shipped sudoers
# grant sudo resets the environment, so a remote invocation always uses the
# real /sys, /etc, and /usr/bin/nvidia-smi.
DOMAIN=""
MAX_MHZ=""
UNLOCK=0
PERSIST=0

usage() {
  echo "usage: $0 --domain cpu-big|cpu-little|gpu (--max-mhz <int>|--unlock) (--persist|--no-persist)" >&2
  exit 1
}

if [ $# -eq 1 ] && [ "$1" = "--check" ]; then
  echo "sparkdash-set-clock: ok"
  exit 0
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --domain) [ $# -ge 2 ] || usage; DOMAIN="$2"; shift 2 ;;
    --max-mhz) [ $# -ge 2 ] || usage; MAX_MHZ="$2"; shift 2 ;;
    --unlock) UNLOCK=1; shift ;;
    --persist) PERSIST=1; shift ;;
    --no-persist) PERSIST=0; shift ;;
    *) usage ;;
  esac
done

[ -n "$DOMAIN" ] || usage
case "$DOMAIN" in
  gpu) OTHER_DOMAIN="" ;;
  cpu-big) OTHER_DOMAIN="cpu-little" ;;
  cpu-little) OTHER_DOMAIN="cpu-big" ;;
  *) echo "unsupported domain: $DOMAIN" >&2; exit 3 ;;
esac

if [ "$UNLOCK" -eq 0 ]; then
  case "$MAX_MHZ" in
    ''|*[!0-9]*) usage ;;
  esac
  # Strip leading zeros so $(( )) never reads the value as octal.
  MAX_MHZ=$(printf '%s' "$MAX_MHZ" | sed 's/^0*//')
  [ -n "$MAX_MHZ" ] || usage
fi

# ─── helpers ──────────────────────────────────────────────

# cores_for DOMAIN → cpuN list grouped by cpuinfo_max_freq (never hardcoded
# indices), numerically sorted so the generated unit is deterministic.
cores_for() {
  d=$1
  for c in "$CPU_SYS"/cpu[0-9]*; do
    [ -d "$c/cpufreq" ] || continue
    max=$(cat "$c/cpufreq/cpuinfo_max_freq" 2>/dev/null || true)
    [ -n "$max" ] || continue
    case "$d" in
      cpu-big) [ "$max" -ge 3000000 ] || continue ;;
      cpu-little) [ "$max" -lt 3000000 ] || continue ;;
    esac
    n=${c##*/cpu}
    printf '%010d %s\n' "$n" "${c##*/}"
  done | sort | cut -d' ' -f2
}

# Knob the live apply ACTUALLY used, set by write_core. The boot unit must
# target the same file: if max_perf exists but refused the write, the unit
# would otherwise silently re-target the file that just failed.
FORCE_SCALING=0

# knob_for cpuN → the cap file the boot unit writes for this core:
# scaling_max_freq when the live apply had to fall back (or max_perf is
# absent), max_perf otherwise. Empty when neither exists.
knob_for() {
  base="$CPU_SYS/$1/cpufreq"
  if [ "$FORCE_SCALING" -eq 0 ] && [ -e "$base/max_perf" ]; then echo max_perf
  elif [ -e "$base/scaling_max_freq" ]; then echo scaling_max_freq
  elif [ -e "$base/max_perf" ]; then echo max_perf
  fi
}

# clamp_khz cpuN KHZ → KHZ clamped into this core's [cpuinfo_min, cpuinfo_max].
clamp_khz() {
  base="$CPU_SYS/$1/cpufreq"
  v=$2
  lo=$(cat "$base/cpuinfo_min_freq" 2>/dev/null || true)
  hi=$(cat "$base/cpuinfo_max_freq" 2>/dev/null || true)
  case "$hi" in ''|*[!0-9]*) ;; *) [ "$v" -le "$hi" ] || v=$hi ;; esac
  case "$lo" in ''|*[!0-9]*) ;; *) [ "$v" -ge "$lo" ] || v=$lo ;; esac
  echo "$v"
}

# write_core cpuN KHZ UNLOCK → write the cap (max_perf, falling back to
# scaling_max_freq when max_perf is absent or refuses the write), read it
# back, and echo the knob that actually holds the value.
write_core() {
  cpu_n=$1
  khz=$2
  unlock=$3
  base="$CPU_SYS/$cpu_n/cpufreq"
  if [ "$unlock" -eq 1 ]; then
    khz=$(cat "$base/cpuinfo_max_freq" 2>/dev/null || true)
    [ -n "$khz" ] || { echo "cannot read cpuinfo_max_freq for $cpu_n" >&2; return 1; }
  else
    khz=$(clamp_khz "$cpu_n" "$khz")
  fi
  knob=""
  if [ -e "$base/max_perf" ] && { echo "$khz" > "$base/max_perf"; } 2>/dev/null; then
    knob=max_perf
  elif [ -e "$base/scaling_max_freq" ] && { echo "$khz" > "$base/scaling_max_freq"; } 2>/dev/null; then
    knob=scaling_max_freq
    [ -e "$base/max_perf" ] && FORCE_SCALING=1
  else
    echo "cap write failed for $cpu_n (no writable max_perf or scaling_max_freq)" >&2
    return 1
  fi
  back=$(cat "$base/$knob" 2>/dev/null || true)
  echo "core=$cpu_n knob=$knob khz=$back"
}

# ─── GPU ──────────────────────────────────────────────────

gpu_apply() {
  if [ "$UNLOCK" -eq 1 ]; then
    "$SMI" -rgc
  else
    "$SMI" -lgc "0,$MAX_MHZ"
  fi
}

gpu_unit_body() {
  if [ "$UNLOCK" -eq 1 ]; then
    exec_line="$SMI -rgc"
  else
    exec_line="$SMI -lgc 0,$MAX_MHZ"
  fi
  cat <<UNIT
[Unit]
Description=Lock NVIDIA GPU graphics clocks to user range
After=nvidia-persistenced.service

[Service]
Type=oneshot
ExecStart=$exec_line
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT
}

# ─── CPU ──────────────────────────────────────────────────

cpu_apply() {
  cores=$(cores_for "$DOMAIN")
  [ -n "$cores" ] || { echo "no cores found for domain $DOMAIN" >&2; return 2; }
  khz=0
  [ "$UNLOCK" -eq 1 ] || khz=$((MAX_MHZ * 1000))
  rc=0
  for cpu_n in $cores; do
    write_core "$cpu_n" "$khz" "$UNLOCK" || rc=1
  done
  return $rc
}

cpu_unit_body() {
  # Both CPU domains share ONE boot unit, so a single-domain Save regenerates
  # the sibling domain from its current live cap (unreadable → omitted, never
  # guessed). Explicit per-core commands — no shell loop variables, because
  # systemd expands $VAR in ExecStart. Each core targets the knob it exposes.
  cmds=""
  for c in $(cores_for "$DOMAIN"); do
    base="$CPU_SYS/$c/cpufreq"
    knob=$(knob_for "$c")
    [ -n "$knob" ] || continue
    if [ "$UNLOCK" -eq 1 ]; then
      cmd="cat $base/cpuinfo_max_freq > $base/$knob"
    else
      cmd="echo $(clamp_khz "$c" $((MAX_MHZ * 1000))) > $base/$knob"
    fi
    if [ -z "$cmds" ]; then cmds="$cmd"; else cmds="$cmds; $cmd"; fi
  done
  [ -n "$cmds" ] || { echo "no cores found for domain $DOMAIN" >&2; return 2; }
  for c in $(cores_for "$OTHER_DOMAIN"); do
    base="$CPU_SYS/$c/cpufreq"
    knob=$(knob_for "$c")
    [ -n "$knob" ] || continue
    khz=$(cat "$base/$knob" 2>/dev/null || true)
    case "$khz" in ''|*[!0-9]*) continue ;; esac
    cmds="$cmds; echo $khz > $base/$knob"
  done
  cat <<UNIT
[Unit]
Description=sparkDash CPU clock cap (big + little domains)
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c '$cmds'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT
}

# persist_unit → 0 only when the boot unit is written AND enabled.
persist_unit() {
  # Never pretend to enable a unit where systemd is not running (e.g. inside
  # a container). The sandbox hook (SPARKDASH_UNIT_DIR) is the only exception.
  if [ -z "${SPARKDASH_UNIT_DIR:-}" ] && [ ! -d /run/systemd/system ]; then
    echo "persist_error: systemd is not running on this host" >&2
    return 1
  fi
  case "$DOMAIN" in
    gpu) UNIT=$GPU_UNIT; gpu_unit_body > "$UNIT.tmp" || { rm -f "$UNIT.tmp"; return 1; } ;;
    *) UNIT=$CPU_UNIT; cpu_unit_body > "$UNIT.tmp" || { rm -f "$UNIT.tmp"; return 1; } ;;
  esac
  chmod 644 "$UNIT.tmp"
  mv "$UNIT.tmp" "$UNIT"
  name=$(basename "$UNIT")
  if [ -n "${SPARKDASH_UNIT_DIR:-}" ]; then
    mkdir -p "$UNIT_DIR/multi-user.target.wants"
    ln -sf "$UNIT" "$UNIT_DIR/multi-user.target.wants/$name"
  else
    systemctl daemon-reload || { echo "persist_error: daemon-reload failed" >&2; return 1; }
    systemctl enable "$name" >/dev/null 2>&1 || { echo "persist_error: systemctl enable $name failed" >&2; return 1; }
  fi
}

# ─── apply, then persist ──────────────────────────────────

case "$DOMAIN" in
  gpu) gpu_apply || { echo "apply failed; nothing persisted" >&2; exit 4; } ;;
  *)
    set +e; cpu_apply; arc=$?; set -e
    if [ "$arc" -ne 0 ]; then
      echo "apply failed; nothing persisted" >&2
      [ "$arc" -eq 2 ] && exit 2
      exit 4
    fi
    ;;
esac

persisted=0
if [ "$PERSIST" -eq 1 ]; then
  if persist_unit; then persisted=1; fi
fi
echo "persisted=$persisted"
echo "All done."
